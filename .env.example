# =============================================================================
# All Round App — environment variables
# Copy this file to `.env.local` for local development and fill in the values
# from your Supabase project (Project Settings -> API). In production, set these
# in Vercel (Project Settings -> Environment Variables).
# =============================================================================

# ---- PUBLIC (safe to expose to the browser; protected by Row-Level Security) --
# Project URL, e.g. https://abcxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon"/publishable key. Public by design — RLS is what enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- SERVER-ONLY SECRET (NEVER prefix with NEXT_PUBLIC, NEVER commit) ---------
# The service-role key bypasses RLS. Only set it in server environments (Vercel)
# and only use it from server code for trusted admin tasks. Leave blank if unused.
SUPABASE_SERVICE_ROLE_KEY=
